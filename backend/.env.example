# =================================================================
# GymConnect Backend Environment Configuration
# =================================================================

# Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=fithub-super-secret-key-12345

# Database URL (SQLite locally, or PostgreSQL/MySQL/Turso for production)
DATABASE_URL="file:./dev.db"

# Admin Cockpit Password (Master authentication code for ADMIN role)
ADMIN_PASSWORD="9450558546028"

# Frontend Application URL (Used to construct password-reset links)
FRONTEND_URL="http://localhost:5173"

# =================================================================
# Brevo (Sendinblue) Transactional Email Service
# =================================================================
# Official API documentation: https://developers.brevo.com/docs/send-a-transactional-email
# 1. Sign up for free at https://brevo.com (300 emails/day free tier)
# 2. Generate an API Key under Settings -> SMTP & API -> API Keys (xkeysib-...)
BREVO_API_KEY=your_brevo_api_key_here

# 3. Add and verify your sender email at https://app.brevo.com/senders:
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME="GymConnect"

# =================================================================
# Legacy SMTP Settings (Optional fallback)
# =================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="GYMGO Support" <no-reply@gymconnect.com>
